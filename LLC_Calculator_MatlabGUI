    ctrlGrid = uigridlayout(rowGrid, [1 4], 'ColumnWidth', {26, '1x', 26, 72}, ...
        'ColumnSpacing', 5, 'Padding', [0 0 0 0]);
    minusBtn = uibutton(ctrlGrid, 'push', 'Text', '-', 'FontSize', 13, 'FontWeight', 'bold', ...
        'BackgroundColor', [0.94 0.95 0.97]);
    sld = uislider(ctrlGrid, 'Limits', [lo hi], 'Value', initVal, 'MajorTicks', [], ...
        'MinorTicks', [], 'FontSize', 8);
    plusBtn = uibutton(ctrlGrid, 'push', 'Text', '+', 'FontSize', 13, 'FontWeight', 'bold', ...
        'BackgroundColor', [0.94 0.95 0.97]);
    editF = uieditfield(ctrlGrid, 'numeric', 'Value', initVal, 'Limits', [lo hi], ...
        'LowerLimitInclusive', 'on', 'UpperLimitInclusive', 'on', 'FontWeight', 'bold', ...
        'FontSize', 12, 'HorizontalAlignment', 'center', 'FontColor', color, ...
        'RoundFractionalValues', 'off');
    sld.ValueChangedFcn      = @(s,e) syncFromSlider();
    editF.ValueChangedFcn    = @(e,ev) syncFromEdit();
    minusBtn.ButtonPushedFcn = @(b,e) stepValue(-step);
    plusBtn.ButtonPushedFcn  = @(b,e) stepValue(step);
    function syncFromSlider()
        editF.Value = sld.Value;
        callback();
    end
    function syncFromEdit()
        v = min(max(editF.Value, lo), hi); editF.Value = v; sld.Value = v; callback();
    end
    function stepValue(delta)
        v = min(max(sld.Value + delta, lo), hi); sld.Value = v; editF.Value = v; callback();
    end
end

