        ''; ...
        'function y = tmean(t, x, t0, t1)'; ...
        '% Time-weighted mean over [t0,t1]. A variable-step solver clusters samples'; ...
        '% wherever the circuit is switching, so a plain mean() of the tail samples is'; ...
        '% biased toward those instants; trapz over time is not.'; ...
        '% Defensive: never index a time-length mask into a shorter signal.'; ...
        '    t = t(:); x = x(:);'; ...
        '    N = min(numel(t), numel(x));'; ...
        '    if N < 2, y = NaN; return; end'; ...
        '    t = t(1:N); x = x(1:N);'; ...
        '    idx = (t >= t0) & (t <= t1);'; ...
        '    if nnz(idx) < 2, y = mean(x(idx)); return; end'; ...
        '    tt = t(idx); xx = x(idx);'; ...
        '    y = trapz(tt, xx) / (tt(end) - tt(1));'; ...
        'end'; ...
        ''; ...
        'function row = logRow(R)'; ...
        '    row = struct(''fsw'', R.fsw, ''Vout'', R.Vout, ''Pin'', R.Pin, ''Pout'', R.Pout, ...'; ...
        '                 ''eff'', R.eff, ''settled'', R.settled, ''ok'', R.ok, ''msg'', R.msg);'; ...
        'end'; ...
        ''; ...
        'function printRow(k, R)'; ...
