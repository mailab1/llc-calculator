        '%% ================= local helper functions ================='; ...
        'function R = runPoint(model, fsw, Vin, OPT)'; ...
        '% One simulation at a fixed fsw, extended until the output stops drifting.'; ...
        '% Returns time-weighted tail averages, never raw mean() over solver samples.'; ...
        '    R = struct(''fsw'', fsw, ''Vout'', NaN, ''Pin'', NaN, ''Pout'', NaN, ''eff'', NaN, ...'; ...
        '               ''settled'', false, ''ok'', false, ''msg'', '''', ''stopTime'', NaN);'; ...
        '    Tsw      = 1/fsw;'; ...
        '    stopTime = OPT.n_periods*Tsw;'; ...
        '    maxStep  = Tsw/OPT.steps_per_period;'; ...
        '    for attempt = 0:OPT.max_extend'; ...
        '        assignin(''base'', ''fsw'', fsw);'; ...
        '        try'; ...
        '            simOut = sim(model, ''ReturnWorkspaceOutputs'', ''on'', ...'; ...
        '                         ''StopTime'', num2str(stopTime, ''%.10g''), ...'; ...
        '                         ''Solver'',   OPT.solver, ...'; ...
        '                         ''MaxStep'',  num2str(maxStep, ''%.10g''));'; ...
        '        catch ME'; ...
        '            R.msg = ME.message; return;'; ...
        '        end'; ...
        '        t = getSig(simOut, ''tout'');'; ...
        '        v = getSig(simOut, ''Vout'');'; ...
        '        i = getSig(simOut, ''Iin'');'; ...
        '        p = getSig(simOut, ''Po'');'; ...
        '        if isempty(t) || isempty(v) || isempty(i)'; ...
        '            R.msg = ''tout, Vout or Iin not available''; return;'; ...
        '        end'; ...
        '        N = min([numel(t), numel(v), numel(i)]);'; ...
        '        if N < 10'; ...
        '            R.msg = sprintf(''only %d samples returned'', N); return;'; ...
        '        end'; ...
        '        t = t(1:N); v = v(1:N); i = i(1:N);'; ...
        '        w = OPT.n_avg*Tsw;'; ...
        '        t2 = t(end); t1 = t2 - w; t0 = t1 - w;'; ...
        '        if t0 < t(1)'; ...
        '            stopTime = 2*stopTime; continue;        % too short to hold two windows'; ...
        '        end'; ...
        '        Vlast = tmean(t, v, t1, t2);'; ...
        '        Vprev = tmean(t, v, t0, t1);'; ...
        '        R.Vout     = Vlast;'; ...
        '        R.Pin      = Vin*tmean(t, i, t1, t2);'; ...
        '        if numel(p) >= N, R.Pout = tmean(t, p(1:N), t1, t2); else, R.Pout = NaN; end'; ...
        '        R.eff      = 100*R.Pout/R.Pin;'; ...
