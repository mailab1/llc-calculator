function h = H(Fn, Q, m)
    % Pure lossless FHA closed form (Resr=0). Used for the Q-family context
    % curves and the "must be 1.000000" identity check, both of which must
    % reproduce the exact lossless identity regardless of the Resr slider.
    if Fn <= 0 || Q <= 0 || m <= 1, h = 0; return; end
    num = Fn * (m - 1) / Q;
    d1  = ((m-1) * (Fn^2 - 1))^2;
    d2  = ((Fn^2 * m - 1) / (Q * Fn))^2;
    den = sqrt(d1 + d2);
    if den < 1e-15, h = 1e6; else, h = num / den; end
end

function h = Hz(Fn, Q, m, resr)
    % Same network as H(), evaluated by complex-impedance division with a
    % series resistance resr (normalised to Zr) included in the loop:
    %   Zp = jXLm || Rac ,  |H| = |Zp| / |jXLr + 1/(jXCr) + resr + Zp|
    % With resr=0 this reproduces H() to numerical precision (see the
    % self-check row in the Full Data Table tab).
    if Fn <= 0 || Q <= 0 || m <= 1, h = 0; return; end
    xL = Fn; xC = -1/Fn; xLm = Fn*(m-1); rac = 1/Q;
    nr = 0; ni = xLm*rac; dr = rac; di = xLm; den = dr*dr + di*di;
    if den < 1e-30, h = 0; return; end
    zpr = (nr*dr+ni*di)/den; zpi = (ni*dr-nr*di)/den;
    tr = resr + zpr; ti = xL + xC + zpi;
    d = hypot(tr, ti);
    if d < 1e-15, h = 1e6; else, h = hypot(zpr, zpi) / d; end
end

function h = Hs(Fn, Q, m, resr)
    % The gain actually used for achievable-peak / operating-point solves:
    % falls back to the pure lossless H() when resr==0, otherwise uses the
    % damped complex-impedance form Hz().
    if nargin < 4, resr = 0; end
    if resr > 0
        h = Hz(Fn, Q, m, resr);
    else
        h = H(Fn, Q, m);
    end
end

function h_vec = H_vec(Fn_arr, Q, m)
    h_vec = zeros(size(Fn_arr));
    for k = 1:numel(Fn_arr), h_vec(k) = H(Fn_arr(k), Q, m); end
end

function Fxmin = findFxmin(Q, m, resr)
    if nargin < 3, resr = 0; end
    Fn_vec = linspace(0.05, 0.999, 3000);
    hv = zeros(size(Fn_vec));
    for i = 1:numel(Fn_vec), hv(i) = Hs(Fn_vec(i), Q, m, resr); end
    [~, idx] = max(hv);
    lo = max(0.05, Fn_vec(idx) - 0.1);
    hi = min(0.999, Fn_vec(idx) + 0.1);
    for iter = 1:100
        x1 = lo + 0.382*(hi-lo);  x2 = lo + 0.618*(hi-lo);
        if Hs(x1, Q, m, resr) < Hs(x2, Q, m, resr), lo = x1; else, hi = x2; end
        if abs(hi-lo) < 1e-10, break; end
    end
    Fxmin = (lo + hi) / 2;
end

function Fop = findOperatingFn(Q, m, Hneed, Fxmin, resr)
% |H| is monotonically DECREASING on [Fxmin, 1] (above the peak, below
% resonance), so a plain bisection lands exactly on the operating point.
% Above unity gain the boost branch is the only one that can supply Hneed;
% if even the peak cannot, clamp to the ZVS boundary.
    if nargin < 5, resr = 0; end
    lo = Fxmin; hi = 1.0;
    if Hs(lo, Q, m, resr) < Hneed, Fop = lo; return; end
    for j = 1:200
        mid = (lo + hi)/2;
        if Hs(mid, Q, m, resr) > Hneed, lo = mid; else, hi = mid; end
    end
    Fop = (lo + hi)/2;
end

function Fop = findOperatingFnWide(Q, m, Hneed, Fxmin, FnMax, resr)
% Same solve, but allowed to run above resonance (used only for plotting the
% operating points, where a gain below 1 legitimately sits at fsw > fr).
    if nargin < 6, resr = 0; end
    lo = Fxmin; hi = FnMax;
    if Hs(lo, Q, m, resr) < Hneed, Fop = lo; return; end
    if Hs(hi, Q, m, resr) > Hneed, Fop = hi; return; end
    for j = 1:200
        mid = (lo + hi)/2;
        if Hs(mid, Q, m, resr) > Hneed, lo = mid; else, hi = mid; end
    end
    Fop = (lo + hi)/2;
end

function out = ternary(cond, a, b)
    if cond, out = a; else, out = b; end
end

function refreshPareto()
    updatePareto();
end

% ------------------------------------------------------------------
% MAIN UPDATE
% ------------------------------------------------------------------
function upd()
    n      = max(0.001, nEdit.Value);
    vinnom = vinnomSlider.Value;
    vinmin = vinminSlider.Value;
    vinmax = vinmaxSlider.Value;
    vout   = voutSlider.Value;
    po     = poSlider.Value;
    fr_k   = frSlider.Value;   fr = fr_k * 1e3;
    m      = mSlider.Value;
    Q      = qSlider.Value;
    Coss   = cossSlider.Value * 1e-12;
    dt_ns  = dtSlider.Value;   dt = dt_ns * 1e-9;
    vf     = vfSlider.Value;
    resrO  = resrSlider.Value / 1000;   % mOhm -> Ohm

    if strcmp(bridge, 'hb'), Kb = 0.5; else, Kb = 1.0; end
    % Vin,max is now a real, independent slider (vinmaxSlider), matching
    % the HTML calculator's basic-vinmax field. It is read above along with
    % vinnom and vinmin, so every ZVS-relevant formula below shares that
    % one user-set value rather than a hardcoded 1.1x-nominal assumption.
    Vbus_nom = Kb * vinnom;
    Vbus_min = Kb * vinmin;
    Vbus_max = Kb * vinmax;


    wr  = 2*pi*fr;
    Io  = po / vout;
    Rac = (8/pi^2) * n^2 * vout^2 / po;
    Zr  = Q * Rac;
    Lr  = Zr / wr;
    Cr  = 1 / (wr * Zr);
    Lm  = (m - 1) * Lr;

    % Series resistance normalised to Zr, for the damped complex-impedance
    % gain Hz()/Hs(). resrN=0 reproduces the lossless closed-form results
    % exactly.
    if resrO > 0, resrN = resrO / Zr; else, resrN = 0; end

    H_at_1     = H(1.0, Q, m);
    Vout_check = Vbus_nom * H_at_1 / n;

    % Required boost now targets the REFLECTED OUTPUT n*(Vo+Vf), not n*Vo:
    % the tank has to make up for the rectifier drop too.
    H_need_nom = (vout+vf) * n / Vbus_nom;
    H_need_min = (vout+vf) * n / Vbus_min;
    H_need_max = (vout+vf) * n / Vbus_max;

    Fxmin   = findFxmin(Q, m, resrN);
    Hmax    = Hs(Fxmin, Q, m, resrN);
    fsw_min = Fxmin * fr_k;

    % Actual operating frequencies (bisection on the monotone boost branch),
    % using the Resr-damped gain so a lossy tank correctly needs a lower
    % frequency (or fails to reach the target at all).
    Fop_min    = findOperatingFn(Q, m, H_need_min, Fxmin, resrN);   fsw_op_min = Fop_min * fr_k;
    Fop_nom    = findOperatingFn(Q, m, H_need_nom, Fxmin, resrN);   fsw_op_nom = Fop_nom * fr_k;
    % BUG FIX: the ZVS worst-case current below was previously evaluated at
    % Fop_nom (the operating point at Vin,nominal) while every comment in
    % this file claimed it was "the high-line corner". Vin,nominal is not
    % the high-line corner - Vin,max is. This is the actual high-line solve,
    % newly added, and it is what ILm_pk below must use.
    Fop_max    = findOperatingFn(Q, m, H_need_max, Fxmin, resrN);   fsw_op_max = Fop_max * fr_k;

    % ---- CORRECTED magnetising current -------------------------------
    % Lm is clamped at the reflected output n*(Vo+Vf) while power is
    % delivered, and it ramps over a half period of the ACTUAL switching
    % frequency. Worst case for ZVS is the HIGH-LINE corner (Vin,max ->
    % highest fsw, smallest ILm). Fop_max (solved above at H_need_max) is
    % that corner.
    Vclamp = n * (vout + vf);
    ILm_pk = Vclamp / (4 * Lm * Fop_max * fr);

    % ---- CORRECTED peak tank current (no fudge factor) ---------------
    Ir_pk1 = (pi/2) * Io / n;
    Ir_pk  = sqrt(Ir_pk1^2 + ILm_pk^2);
    Ir_rms = Ir_pk / sqrt(2);
    ratio  = ILm_pk / Ir_pk;

    % ---- CORRECTED resonant-capacitor voltage ------------------------
    wsw_nom = 2*pi*Fop_nom*fr;
    Vcr_ac  = Ir_pk / (wsw_nom * Cr);            % AC half-swing
    Vcr_dc  = ternary(Kb == 0.5, Vbus_nom, 0);   % DC bias: Vin/2 in a half bridge
    Vcr_pk  = Vcr_dc + Vcr_ac;                   % absolute peak -> cap rating

    % ---- ZVS ---------------------------------------------------------
    % BUG FIX: this used Ceq*Vbus_nom/ILm_pk. Two separate errors stacked
    % here: (1) Vbus_nom is the NOMINAL corner, not the high-line worst
    % case; (2) Vbus = Kb*Vin is the tank excitation amplitude used in the
    % FHA gain equations, but the switch NODE (whose output capacitance is
    % what actually has to be charged/discharged for ZVS) swings the FULL
    % Vin in a half-bridge as well as a full-bridge - not Vin/2. Using
    % Vbus_nom therefore silently HALVED the required dead time in
    % half-bridge mode (Kb=0.5), the tool's default. The HTML calculator
    % gets this right (S.Vsw_max = S.vinmax, "switch-node swing = Vin, both
    % topologies") and this now matches it: raw vinmax, not Vbus_nom.
    Ceq = 2 * Coss;
    if Ceq > 0 && ILm_pk > 0
        tdead_min = Ceq * vinmax / ILm_pk;     % NOTE: no pi factor - see header comment (matches
                                                % Infineon Code Listing 8/9 and onsemi FCB199N65S3:
                                                % tZVS = 2*Coss*Vin/ILm = Ceq*Vin/ILm (Ceq=2*Coss),
                                                % evaluated at Vin,max, the true high-line corner.
    else
        tdead_min = 999;
    end
    zvs_ok   = (dt >= tdead_min)        && (ratio >= 0.2);
    zvs_marg = (dt >= tdead_min * 0.75) && (ratio >= 0.15);

    if Hmax >= H_need_min * 1.05
        gColor = COL_GREEN; gBg = [0.941 0.992 0.957];
        gMsg = sprintf('Gain OK - Hmax=%.3f >= H_req=%.3f', Hmax, H_need_min);
    elseif Hmax >= H_need_min
        gColor = COL_ORANGE; gBg = [1 0.984 0.902];
        gMsg = sprintf('Marginal - Hmax=%.3f barely >= H_req=%.3f', Hmax, H_need_min);
    else
        gColor = COL_RED; gBg = [0.996 0.949 0.949];
        gMsg = sprintf('FAIL - Hmax=%.3f < H_req=%.3f', Hmax, H_need_min);
    end

    if zvs_ok,        zStat = 'ok';   zvsStatusTxt = 'ZVS OK';
    elseif zvs_marg,  zStat = 'warn'; zvsStatusTxt = 'Marginal';
    else,             zStat = 'err';  zvsStatusTxt = 'FAILS'; end
    zMsg = sprintf('need %.0f ns, have %.0f ns - %s', tdead_min*1e9, dt_ns, zvsStatusTxt);

    % ---- Metrics -----------------------------------------------------
    metricVals{1}.Text  = sprintf('%.3f uH',  Lr*1e6);
    metricVals{2}.Text  = sprintf('%.3f nF',  Cr*1e9);
    metricVals{3}.Text  = sprintf('%.2f uH',  Lm*1e6);
    metricVals{4}.Text  = sprintf('%.3f Ohm', Zr);
    metricVals{5}.Text  = sprintf('%.3f Ohm', Rac);
    metricVals{6}.Text  = sprintf('%.4f A',   Ir_pk);
    metricVals{7}.Text  = sprintf('%.1f mA',  ILm_pk*1e3);
    metricVals{8}.Text  = sprintf('%.1f %%',  ratio*100);
    metricVals{9}.Text  = sprintf('%.1f V',   Vcr_pk);

    if abs(H_at_1 - 1) < 1e-6
        metricVals{10}.Text = sprintf('%.8f  [OK]', H_at_1);  metricVals{10}.FontColor = COL_GREEN;
    else
        metricVals{10}.Text = sprintf('%.8f  [ERROR]', H_at_1); metricVals{10}.FontColor = COL_RED;
    end
    if abs(Vout_check - vout) < 0.5
        metricVals{11}.Text = sprintf('%.3f V  [OK]', Vout_check); metricVals{11}.FontColor = COL_GREEN;
    else
        metricVals{11}.Text = sprintf('%.3f V (tgt %.0f V)', Vout_check, vout);
        metricVals{11}.FontColor = COL_ORANGE;
    end
    if Hmax >= H_need_min
        metricVals{12}.Text = sprintf('%.4f / %.4f  [OK]', Hmax, H_need_min);
        metricVals{12}.FontColor = COL_GREEN;
    else
        metricVals{12}.Text = sprintf('%.4f / %.4f  [FAIL]', Hmax, H_need_min);
        metricVals{12}.FontColor = COL_RED;
    end
    metricVals{13}.Text     = sprintf('%.1f | %.1f | %.1f | %.1f kHz', fsw_min, fsw_op_max, fsw_op_nom, fsw_op_min);
    metricVals{13}.FontSize = 10;
    metricVals{14}.Text     = zMsg;
    switch zStat
        case 'ok',   metricVals{14}.FontColor = COL_GREEN;
        case 'warn', metricVals{14}.FontColor = COL_ORANGE;
        otherwise,   metricVals{14}.FontColor = COL_RED;
    end

    gainBadgeLbl.Text            = gMsg;
    gainBadgeLbl.FontColor       = gColor;
    gainBadgePanel.BackgroundColor = gBg;
    gainBadgePanel.HighlightColor  = gColor;

    % ---- Save state --------------------------------------------------
    S.n = n; S.vinnom = vinnom; S.vinmin = vinmin; S.vinmax = vinmax; S.vout = vout; S.po = po;
    S.fr_k = fr_k; S.fr = fr; S.m = m; S.Q = Q; S.Coss = Coss;
    S.dt = dt; S.dt_ns = dt_ns; S.Kb = Kb;
    S.vf = vf; S.resr = resrO; S.resrN = resrN;
    S.Vbus_nom = Vbus_nom; S.Vbus_min = Vbus_min; S.Vbus_max = Vbus_max;
    S.Lr = Lr; S.Cr = Cr; S.Lm = Lm; S.Zr = Zr; S.Rac = Rac; S.Io = Io;
    S.Ir_pk = Ir_pk; S.Ir_rms = Ir_rms; S.ILm_pk = ILm_pk; S.ratio = ratio; S.Vclamp = Vclamp;
    S.H_need_nom = H_need_nom; S.H_need_min = H_need_min; S.H_need_max = H_need_max;
    S.Fxmin = Fxmin; S.Hmax = Hmax; S.fsw_min = fsw_min;
    S.Fop_nom = Fop_nom; S.Fop_min = Fop_min; S.Fop_max = Fop_max;
    S.fsw_op_nom = fsw_op_nom; S.fsw_op_min = fsw_op_min; S.fsw_op_max = fsw_op_max;
    S.zvs_ok = zvs_ok; S.zvs_marg = zvs_marg; S.tdead_min = tdead_min;
    S.Ceq = Ceq; S.Vcr_ac = Vcr_ac; S.Vcr_dc = Vcr_dc; S.Vcr_pk = Vcr_pk;
    S.H_at_1 = H_at_1; S.Vout_check = Vout_check;

    updateDesignTable();

    gainNoteLbl.Text = sprintf(['fsw: ZVS boundary %.1f kHz | at Vin_nom %.1f kHz | at Vin_min %.1f kHz.  ' ...
        'Hmax=%.4f vs H_req=%.4f.'], fsw_min, fsw_op_nom, fsw_op_min, Hmax, H_need_min);
    zvsNoteLbl.Text = sprintf(['ILm_pk=%.1f mA (Lm clamped at n*(Vo+Vf)=%.1f V, ramping over half a period ' ...
        'of fsw=%.1f kHz AT Vin_max=%.0f V). tdead_min=%.0f ns, available %.0f ns. %s'], ...
        ILm_pk*1e3, Vclamp, fsw_op_max, vinmax, tdead_min*1e9, dt_ns, zvsStatusTxt);

    drawGain(); drawOp(); drawZVS();
    % The waveform tab runs a full time-domain steady-state solve, so only
    % refresh it when it is actually on screen (keeps the sliders responsive).
    if isequal(tabGroup.SelectedTab, tabWave), drawWaveforms(); end
end

function onTabChange()
    if isequal(tabGroup.SelectedTab, tabWave), drawWaveforms(); end
end

