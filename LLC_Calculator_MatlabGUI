% ------------------------------------------------------------------
% REAL STEADY-STATE TANK SOLVE (trapezoidal, 3-state rectifier)
% ------------------------------------------------------------------
function R = llcWave(Vbus, fsw)
% Trapezoidal (A-stable) integration of iLr, vCr, iLm plus the output C-R
% stage, run from rest until the rail settles. The rectifier is an explicit
% 3-state machine rather than diode equations, which avoids convergence
% trouble:
%   st = +1/-1 : a secondary pair conducts, Lm is clamped at +/- n*Vo;
%                leave when the secondary current reaches zero.
%   st =  0    : freewheel, both pairs blocking, Lr and Lm in series so
%                iLm == iLr; leave when the voltage that would appear across
%                Lm exceeds the clamp.
% The drive is +/-Vbus (the AC part of the bridge node about its own mean),
% so vCr here is the AC component; the physical DC bias is added afterwards.
    n = S.n; Lr = S.Lr; Lm = S.Lm; Cr = S.Cr;
    RL = S.vout^2 / max(S.po, 1);
    Th = 1/(2*fsw); Nsub = 300; dtS = Th/Nsub; Co = 25/(fsw*RL);
    Zr = sqrt(Lr/Cr); Rs = 0.005*Zr; Ls = Lr + Lm;
    iLr = 0; vCr = 0; iLm = 0; vCo = S.vout; st = 0; half = 0;

    prev = vCo; c = 0;
    while c < 400
        for b = 1:20
            if half, Va = -Vbus; else, Va = Vbus; end
            for k = 1:Nsub
                is = stepTank(Va);
                vCo = vCo + dtS*(is - vCo/RL)/Co;
                if vCo < 0, vCo = 0; end
            end
            half = 1 - half; c = c + 1;
        end
        if vCo > 1e-6 && abs(vCo - prev)/vCo < 3e-4, break; end
        prev = vCo;
    end

    Ntot = 4*Nsub;
    tArr = zeros(Ntot,1); VabArr = zeros(Ntot,1); iLrArr = zeros(Ntot,1);
    iLmArr = zeros(Ntot,1); iSecArr = zeros(Ntot,1); vCrArr = zeros(Ntot,1);
    t = 0; iLrPk = 0; iLrSq = 0; iSecPk = 0; vCrHi = -1e9; vCrLo = 1e9; idx = 0;
    for h2 = 0:3                                    % two full periods
        if mod(h2,2), Va2 = -Vbus; else, Va2 = Vbus; end
        for k2 = 1:Nsub
            is2 = stepTank(Va2);
            vCo = vCo + dtS*(is2 - vCo/RL)/Co;
            if vCo < 0, vCo = 0; end
            idx = idx + 1;
            tArr(idx) = t; VabArr(idx) = Va2; iLrArr(idx) = iLr;
            iLmArr(idx) = iLm; iSecArr(idx) = is2; vCrArr(idx) = vCr;
            iLrPk = max(iLrPk, abs(iLr)); iLrSq = iLrSq + iLr^2*dtS;
            iSecPk = max(iSecPk, is2);
            vCrHi = max(vCrHi, vCr); vCrLo = min(vCrLo, vCr);
            t = t + dtS;
        end
    end

    R = struct('t', tArr, 'Vab', VabArr, 'iLr', iLrArr, 'iLm', iLmArr, ...
        'iSec', iSecArr, 'vCr', vCrArr, 'Vo', vCo, 'Po', vCo^2/RL, ...
        'cycles', c, 'iLrPk', iLrPk, 'iLrRms', sqrt(iLrSq/max(t,eps)), ...
        'iSecPk', iSecPk, 'vCrHi', vCrHi, 'vCrLo', vCrLo, ...
        'dcCr', ternary(S.Kb == 0.5, Vbus, 0), 'fsw', fsw);

    function isec = stepTank(Va)
        vO = n*vCo; h = dtS/2; G = h/Cr;
        if st ~= 0
            vP = st*vO; K = h/Lr;
            i1 = (iLr + K*((Va - vCr - vP - Rs*iLr) + ((Va - vP) - vCr - G*iLr))) / (1 + K*Rs + K*G);
            v1 = vCr + G*(iLr + i1);
            m1 = iLm + dtS*vP/Lm;
            if st*(i1 - m1) <= 0
                st = 0; m1 = i1;
            else
                iLr = i1; vCr = v1; iLm = m1;
                isec = abs(i1 - m1)*n; return;
            end
        end
        K  = h/Ls;
        i1 = (iLr + K*((Va - vCr - Rs*iLr) + (Va - vCr - G*iLr))) / (1 + K*Rs + K*G);
        v1 = vCr + G*(iLr + i1);
        m1 = i1;
        vLm = (Lm/Ls)*(Va - v1 - Rs*i1);
        if abs(vLm) > vO
            if vLm > 0, st = 1; else, st = -1; end
        end
        iLr = i1; vCr = v1; iLm = m1;
        isec = 0;
    end
end

% ------------------------------------------------------------------
% PLOTS
% ------------------------------------------------------------------
   function drawGain()
    cla(gainAx, 'reset');
    if isempty(S) || ~isfield(S, 'fr_k'), return; end
    hold(gainAx, 'on');
    frk = S.fr_k; fMin = 0.2*frk; fMax = 2.0*frk; yMax = 3.0;
    
    % HIGHER RESOLUTION: more Q values with finer steps
    qVals = 0.1:0.05:1.5;  % 29 curves
    nQ = numel(qVals);
    
    if S.fsw_min < fMax
        patch(gainAx, [S.fsw_min fMax fMax S.fsw_min], [0 0 yMax yMax], COL_GREEN, ...
            'FaceAlpha', 0.08, 'EdgeColor', 'none', 'HandleVisibility', 'off');
    end
    
    N = 500;
    
    % Find the index of the Q closest to current S.Q for highlighting
    [~, highlightIdx] = min(abs(qVals - S.Q));
    
    % Plot all curves
    for qi = 1:nQ
        q = qVals(qi);
        f = linspace(fMin, fMax, N);
        h = H_vec(f/frk, q, S.m);
        
        if qi == highlightIdx
            % Current Q - highlight with bright blue and glow effect
            % First plot a thicker, semi-transparent blue as glow
            plot(gainAx, f, h, 'Color', [COL_BLUE, 0.1], 'LineWidth', 6, ...
                'HandleVisibility', 'off');
            % Then the main blue line
            plot(gainAx, f, h, 'Color', COL_BLUE, 'LineWidth', 2.5, ...
                'DisplayName', sprintf('Q=%.2f (current)', q));
        else
            % Other curves - muted gray with subtle gradient
            % Slightly vary gray level based on distance from current Q
            distFromCurrent = abs(qi - highlightIdx) / nQ;
            if distFromCurrent < 0.15
                % Slightly darker for curves close to current Q
                grayLevel = 0.65;
                lineWidth = 1.0;
            else
                % Lighter for curves far from current Q
                grayLevel = 0.75 - 0.15 * distFromCurrent;
                lineWidth = 0.7;
            end
            mutedColor = [grayLevel, grayLevel, grayLevel];
            
            % Only show legend for every 4th curve to avoid clutter
            if mod(qi, 4) == 1 || qi == nQ
                dispName = sprintf('Q=%.2f', q);
            else
                dispName = '';
            end
            
            plot(gainAx, f, h, 'Color', mutedColor, 'LineWidth', lineWidth, ...
                'DisplayName', dispName);
        end
    end
    
    % Reference lines
    plot(gainAx, [fMin fMax], [1 1], '--', 'Color', [0.5 0.5 0.5], ...
        'LineWidth', 1, 'HandleVisibility', 'off');
    
    if S.H_need_min <= yMax
        plot(gainAx, [fMin fMax], [S.H_need_min S.H_need_min], '--', 'Color', COL_RED, ...
            'LineWidth', 1.2, 'HandleVisibility', 'off');
    end
    
    xline(gainAx, S.fsw_min, '--', 'Color', COL_ORANGE, 'LineWidth', 1.2, ...
        'HandleVisibility', 'off');
    
    % Peak-gain / ZVS-boundary marker only. The three Vin_min/nom/max
    % operating-point dots (and their labels) previously drawn here have
    % been removed - they duplicated the dedicated "Op. Points" tab and
    % cluttered the main curve. That tab still shows them.
    plot(gainAx, S.fsw_min, S.Hmax, 'o', 'MarkerSize', 10, 'MarkerFaceColor', COL_ORANGE, ...
        'MarkerEdgeColor', 'white', 'LineWidth', 1.5, 'HandleVisibility', 'off');

    title(gainAx, sprintf('Gain Curves (m=%.2f, %s, fr=%.0f kHz) - Q=%.2f highlighted', ...
        S.m, upper(bridge), S.fr_k, S.Q), ...
        'FontSize', 12, 'FontWeight', 'bold');
    xlabel(gainAx, 'Frequency (kHz)');
    ylabel(gainAx, 'Tank gain |H|');
    xlim(gainAx, [fMin fMax]); 
    ylim(gainAx, [0 yMax]);
    grid(gainAx, 'on');
    gainAx.GridAlpha = 0.3;
    
    % Legend showing every 4th curve plus the highlighted one
    legend(gainAx, 'Location', 'eastoutside', 'FontSize', 8, 'Box', 'on');
    hold(gainAx, 'off');
end
function drawOp()
    cla(opAx, 'reset');
    if isempty(S) || ~isfield(S, 'fr_k'), return; end
    hold(opAx, 'on');
    xMin = 0.2; xMax = 2.0; yMax = 3.0;
    Fn = linspace(xMin, xMax, 500); h = H_vec(Fn, S.Q, S.m);
    patch(opAx, [S.Fxmin xMax xMax S.Fxmin], [0 0 yMax yMax], COL_GREEN, ...
        'FaceAlpha', 0.12, 'EdgeColor', 'none', 'HandleVisibility', 'off');
    plot(opAx, Fn, h, 'Color', COL_BLUE, 'LineWidth', 2.2, 'DisplayName', sprintf('Q=%.2f', S.Q));
    plot(opAx, Fn, H_vec(Fn, 0.05, S.m), 'Color', [0.749 0.855 0.996], 'LineWidth', 1, ...
        'DisplayName', 'Q=0.05 (no load)');
    xline(opAx, S.Fxmin, '--', 'Color', COL_ORANGE, 'LineWidth', 0.8, 'HandleVisibility', 'off');

    % Vin,max is a real, independent slider (S.vinmax) rather than a derived
    % ratio, so this marker just uses that single shared value - same as
    % every other ZVS-relevant formula in this file. H_need now targets the
    % reflected output including Vf, matching upd().
    vinPts = { S.vinmin, S.Vbus_min, COL_RED,   sprintf('Vin_{min}=%.0fV', S.vinmin);
               S.vinnom, S.Vbus_nom, COL_GREEN, sprintf('Vin_{nom}=%.0fV', S.vinnom);
               S.vinmax, S.Vbus_max, COL_GRAY,  sprintf('Vin_{max}=%.0fV', S.vinmax) };
    for vi = 1:size(vinPts,1)
        Vbus_i = vinPts{vi,2}; col = vinPts{vi,3}; lbl = vinPts{vi,4};
        H_need = (S.vout + S.vf) * S.n / Vbus_i;
        if H_need <= 0 || H_need > yMax*1.1, continue; end
        Fn_op = findOperatingFnWide(S.Q, S.m, H_need, S.Fxmin, xMax, S.resrN);
        h_op  = Hs(Fn_op, S.Q, S.m, S.resrN);
        if H_need <= yMax
            plot(opAx, [xMin xMax], [H_need H_need], ':', 'Color', col, 'LineWidth', 0.7, 'HandleVisibility', 'off');
        end
        plot(opAx, Fn_op, h_op, 'o', 'MarkerSize', 7, 'MarkerFaceColor', col, ...
            'MarkerEdgeColor', 'white', 'LineWidth', 1, 'HandleVisibility', 'off');
        text(opAx, Fn_op, h_op+0.12, lbl, 'FontSize', 8, 'FontWeight', 'bold', ...
            'Color', col, 'HorizontalAlignment', 'center');
        if Fn_op >= S.Fxmin, zvsTxt = 'ZVS'; zvsCol = COL_GREEN;
        else,                zvsTxt = 'NO ZVS'; zvsCol = COL_RED; end
        text(opAx, Fn_op, max(h_op-0.18, 0.05), zvsTxt, 'FontSize', 7, 'FontWeight', 'bold', ...
            'Color', zvsCol, 'HorizontalAlignment', 'center');
    end
    title(opAx, 'Operating Points vs ZVS Boundary', 'FontSize', 11, 'FontWeight', 'bold');
    xlabel(opAx, 'Fn = fsw / fr'); ylabel(opAx, 'Tank gain |H|');
    xlim(opAx, [xMin xMax]); ylim(opAx, [0 yMax]);
    grid(opAx, 'on'); legend(opAx, 'Location', 'eastoutside', 'FontSize', 8);
    hold(opAx, 'off');
end

function drawZVS()
    cla(zvsAx, 'reset');
    if isempty(S) || ~isfield(S, 'fr_k'), return; end
    hold(zvsAx, 'on');
    mMin = 2; mMax = 12; mArr = mMin:0.05:mMax;
    ILmArr = zeros(size(mArr)); tdArr = zeros(size(mArr));
    Lr_i = S.Zr / (2*pi*S.fr);
    for k = 1:numel(mArr)
        Lm_i = (mArr(k)-1)*Lr_i;
        % BUG FIX: was S.Fop_nom (operating point at Vin,nominal). The ZVS
        % sweep must use the same high-line corner as upd()'s ILm_pk, or
        % this tab and the left-panel metric disagree with each other.
        % Vclamp now correctly includes the rectifier drop Vf.
        ilm  = S.Vclamp / (4*Lm_i*S.Fop_max*S.fr);   % corrected clamp + fsw, at Vin_max
        ILmArr(k) = ilm*1e3;
        % BUG FIX: was S.Ceq*S.Vbus_nom/ilm (nominal-corner Vbus, not the
        % high-line switch-node voltage - see the upd() note for why Vbus
        % is the wrong quantity here in a half-bridge, not just the wrong
        % corner). Now S.Ceq*S.vinmax/ilm, matching upd()'s tdead_min.
        if S.Ceq > 0 && ilm > 0, td = S.Ceq*S.vinmax/ilm; else, td = 9999e-9; end
        tdArr(k) = min(td*1e9, 2000);
    end

    yyaxis(zvsAx, 'left');
    plot(zvsAx, mArr, ILmArr, '-', 'Color', COL_PURPLE, 'LineWidth', 2, 'DisplayName', 'ILm_{pk} (mA)');
    ylabel(zvsAx, 'ILm_{pk} (mA)');
    zvsAx.YColor = COL_PURPLE;
    ylim(zvsAx, [0 max(ILmArr)*1.15]);
    [~, mIdx] = min(abs(mArr - S.m));
    plot(zvsAx, S.m, ILmArr(mIdx), 'o', 'MarkerSize', 8, 'MarkerFaceColor', COL_PURPLE, ...
        'MarkerEdgeColor', 'white', 'LineWidth', 1, 'HandleVisibility', 'off');

    yyaxis(zvsAx, 'right');
    plot(zvsAx, mArr, tdArr, '-', 'Color', COL_ORANGE, 'LineWidth', 2, 'DisplayName', 'tdead needed (ns)');
    yline(zvsAx, S.dt_ns, '--', sprintf('tdead available = %.0f ns', S.dt_ns), ...
        'Color', COL_GREEN, 'LineWidth', 1.5, 'LabelHorizontalAlignment', 'left', ...
        'FontSize', 9, 'HandleVisibility', 'off');
    plot(zvsAx, S.m, tdArr(mIdx), 'o', 'MarkerSize', 8, 'MarkerFaceColor', COL_ORANGE, ...
        'MarkerEdgeColor', 'white', 'LineWidth', 1, 'HandleVisibility', 'off');
    ylabel(zvsAx, 't_{dead} needed (ns)');
    zvsAx.YColor = COL_ORANGE;
    ylim(zvsAx, [0 min(2000, max(max(tdArr), S.dt_ns)*1.3)]);

    xline(zvsAx, S.m, ':', 'Color', [0.6 0.6 0.6], 'LineWidth', 1, 'HandleVisibility', 'off');
    title(zvsAx, sprintf('ZVS vs m   (current m=%.1f: ILm_{pk}=%.1f mA, t_{dead} needed %.0f ns)', ...
        S.m, ILmArr(mIdx), tdArr(mIdx)), 'FontSize', 11, 'FontWeight', 'bold');
    xlabel(zvsAx, 'm = (Lr+Lm)/Lr'); xlim(zvsAx, [mMin mMax]);
    grid(zvsAx, 'on'); legend(zvsAx, 'Location', 'northeast', 'FontSize', 8);
    hold(zvsAx, 'off');
end

function drawWaveforms()
    cla(waveformAx, 'reset');
    if isempty(S) || ~isfield(S, 'fr'), return; end
    % Simulated AT RESONANCE with nominal input: |H| = 1 there for every Q and
    % m, so the tank sits at its unity-gain anchor - the canonical waveforms
    % the design is built around, with no operating-point solve needed.
    fsw = S.fr;
    R = llcWave(S.Vbus_nom, fsw);
    dc = R.dcCr;
    t_us = R.t*1e6;

    % Five quantities spanning volts-to-amps and 3 orders of magnitude cannot
    % share one pair of axes legibly, so each gets its own horizontal lane,
    % normalised to its own peak. The printed pk= value on each lane carries
    % the real magnitude; the shape is what the lane is there to show.
    vCrAC   = R.vCr;                                   % AC part about its mean
    pkVab   = max(abs(R.Vab));            if pkVab   < eps, pkVab   = 1; end
    pkILr   = max(abs(R.iLr));            if pkILr   < eps, pkILr   = 1; end
    pkILm   = max(abs(R.iLm));            if pkILm   < eps, pkILm   = 1; end
    pkIsec  = max(R.iSec);                if pkIsec  < eps, pkIsec  = 1; end
    pkVcr   = max(abs(vCrAC));            if pkVcr   < eps, pkVcr   = 1; end

    lanes = { 'V_{ab}',  R.Vab,   pkVab,  COL_BLUE,   0, sprintf('%.0f V', pkVab);
              'I_{Lr}',  R.iLr,   pkILr,  COL_GREEN,  0, sprintf('%.2f A', pkILr);
              'I_{Lm}',  R.iLm,   pkILm,  COL_PURPLE, 0, sprintf('%.0f mA', pkILm*1e3);
              'I_{rec}', R.iSec,  pkIsec, COL_ORANGE, 1, sprintf('%.1f A', pkIsec);
              'V_{Cr}',  vCrAC,   pkVcr,  COL_TEAL,   0, sprintf('%.0f V', dc + pkVcr) };
    nLane = size(lanes,1);

    hold(waveformAx, 'on');
    tickPos = zeros(nLane,1); tickLbl = cell(nLane,1);
    for li = 1:nLane
        cyL   = nLane - li + 1;             % lane 1 on top
        sig   = lanes{li,2}; pk = lanes{li,3}; col = lanes{li,4}; isPos = lanes{li,5};
        tickPos(nLane-li+1) = cyL;
        tickLbl{nLane-li+1} = lanes{li,1};
        if isPos
            base = cyL - 0.34;
            y    = base + 0.68*(sig/pk);
            fill(waveformAx, [t_us; flipud(t_us)], [y; base*ones(size(y))], col, ...
                'FaceAlpha', 0.10, 'EdgeColor', 'none', 'HandleVisibility', 'off');
        else
            base = cyL;
            y    = cyL + 0.34*(sig/pk);
        end
        plot(waveformAx, [0 max(t_us)], [base base], '-', 'Color', [0.75 0.78 0.83], ...
            'LineWidth', 0.5, 'HandleVisibility', 'off');
        plot(waveformAx, t_us, y, '-', 'Color', col, 'LineWidth', 1.7, 'HandleVisibility', 'off');
        text(waveformAx, max(t_us)*0.995, cyL + 0.40, ['pk = ' lanes{li,6}], ...
            'FontSize', 8.5, 'Color', col, ...
            'HorizontalAlignment', 'right', 'VerticalAlignment', 'top');
    end
    % half-period boundaries
    for hb = 1:3
        xline(waveformAx, hb*max(t_us)/4, ':', 'Color', [0.8 0.82 0.86], ...
            'LineWidth', 0.8, 'HandleVisibility', 'off');
    end
    waveformAx.YTick      = tickPos;
    waveformAx.YTickLabel = tickLbl;
    waveformAx.FontSize   = 10;
    ylim(waveformAx, [0.4 nLane + 0.75]);
    title(waveformAx, sprintf('Steady-state tank solve - 2 periods at fsw = fr = %.0f kHz, Vin = %.0f V', ...
        S.fr_k, S.vinnom), 'FontSize', 11, 'FontWeight', 'bold');
    xlabel(waveformAx, 'Time (\mus)');
    xlim(waveformAx, [0 max(t_us)]);
    grid(waveformAx, 'off');
    hold(waveformAx, 'off');

    vcr_hi = R.vCrHi + dc; vcr_lo = R.vCrLo + dc;
    waveNoteLbl.Text = sprintf(['Each trace is normalised to its own peak (pk= label carries the real value). ' ...
        'Solved from your actual Lr, Cr, Lm, n and load, settled in %d cycles: output %.2f V at %.0f W. ' ...
        'iLr_pk=%.3f A (rms %.3f A), iLm_pk=%.0f mA, irec_pk=%.1f A. ' ...
        'V_Cr is drawn about its own mean; adding the %.0f V DC bias it spans %.0f .. %.0f V. ' ...
        'Closed-form estimates: Ir_pk=%.3f A, Vcr_pk=%.1f V.'], ...
        R.cycles, R.Vo, R.Po, R.iLrPk, R.iLrRms, max(abs(R.iLm))*1e3, max(R.iSec), ...
        dc, vcr_lo, vcr_hi, S.Ir_pk, S.Vcr_pk);
end

function updatePareto()
    cla(paretoAx, 'reset');
    if isempty(S) || ~isfield(S, 'fr'), return; end
    hold(paretoAx, 'on');
    xVar = paretoXDrop.Value; yVar = paretoYDrop.Value;
    m_vec = 2:0.25:12; q_vec = 0.05:0.05:1.5;
    n_m = numel(m_vec); n_q = numel(q_vec);
    data_m = zeros(n_m, n_q); data_Q = zeros(n_m, n_q);
    data_gm = zeros(n_m, n_q); data_zm = zeros(n_m, n_q);
    feasible = false(n_m, n_q);

    n0 = S.n; vout0 = S.vout; vf0 = S.vf; Kb0 = S.Kb; resrN0 = S.resrN;
    H_need_min0 = (vout0+vf0)*n0/(Kb0*S.vinmin);
    % BUG FIX: this was H_need_nom0 = vout0*n0/(Kb0*S.vinnom) - the NOMINAL
    % corner - and was used below to solve the ZVS-worst-case operating
    % point for every (Q,m) cell in the map. It must be the same high-line
    % corner used everywhere else in this file, i.e. S.H_need_max (already
    % computed once in upd() as n*(Vo+Vf)/(Kb*Vin_max), reused here rather
    % than recomputed, so there is exactly one definition to keep in sync).
    H_need_max0 = S.H_need_max;
    fr0 = S.fr; Rac0 = S.Rac; Ceq0 = S.Ceq; dt0 = S.dt; vinmax0 = S.vinmax;

    for i = 1:n_m
        m_cur = m_vec(i);
        for j = 1:n_q
            q_cur = q_vec(j);
            Lr_cur = q_cur*Rac0/(2*pi*fr0);
            Lm_cur = (m_cur-1)*Lr_cur;
            Fxmin_cur = findFxmin(q_cur, m_cur, resrN0);
            Hmax_cur  = Hs(Fxmin_cur, q_cur, m_cur, resrN0);
            if Hmax_cur <= 0, continue; end
            gm_cur = Hmax_cur / H_need_min0;
            % same corrected ILm: clamp n*(Vo+Vf), half period of the actual
            % fsw, solved at the high-line (Vin_max) corner, with the
            % Resr-damped gain used for the operating-frequency solve.
            Fop_cur = findOperatingFn(q_cur, m_cur, H_need_max0, Fxmin_cur, resrN0);
            ILm_pk_cur = (n0*(vout0+vf0)) / (4*Lm_cur*Fop_cur*fr0);
            % same fix as upd()/drawZVS(): raw vinmax0, not Vbus_nom.
            if Ceq0 > 0 && ILm_pk_cur > 0
                zm_cur = dt0 / (Ceq0*vinmax0/ILm_pk_cur);
            else
                zm_cur = 0;
            end
            data_m(i,j) = m_cur; data_Q(i,j) = q_cur;
            data_gm(i,j) = gm_cur; data_zm(i,j) = zm_cur;
            feasible(i,j) = (gm_cur >= 1) && (zm_cur >= 1);
        end
    end

    m_flat = data_m(:); Q_flat = data_Q(:); gm_flat = data_gm(:); zm_flat = data_zm(:);
    feas_flat = feasible(:); valid = (m_flat > 0) & (Q_flat > 0);
    m_flat = m_flat(valid); Q_flat = Q_flat(valid); gm_flat = gm_flat(valid);
    zm_flat = zm_flat(valid); feas_flat = feas_flat(valid);
    if isempty(m_flat)
        text(paretoAx, 0.5, 0.5, 'No valid designs', 'HorizontalAlignment', 'center'); return;
    end

    X = pickVar(xVar, m_flat, Q_flat, gm_flat, zm_flat);
    Y = pickVar(yVar, m_flat, Q_flat, gm_flat, zm_flat);
    feasIdx = find(feas_flat); infeasIdx = find(~feas_flat);
    if ~isempty(infeasIdx)
        scatter(paretoAx, X(infeasIdx), Y(infeasIdx), 36, [0.6 0.6 0.6], ...
            'MarkerEdgeColor', [0.5 0.5 0.5], 'LineWidth', 0.5, 'DisplayName', 'Infeasible');
    end
    if ~isempty(feasIdx)
        scatter(paretoAx, X(feasIdx), Y(feasIdx), 40, COL_GREEN, 'filled', ...
            'MarkerEdgeColor', 'none', 'DisplayName', 'Feasible');
    end
    cur_gm = S.Hmax/S.H_need_min; cur_zm = S.dt/S.tdead_min;
    curX = pickVar(xVar, S.m, S.Q, cur_gm, cur_zm);
    curY = pickVar(yVar, S.m, S.Q, cur_gm, cur_zm);
    scatter(paretoAx, curX, curY, 110, COL_RED, 'filled', 'MarkerEdgeColor', 'k', ...
        'LineWidth', 1.5, 'DisplayName', 'Current design');
    xlabel(paretoAx, xVar); ylabel(paretoAx, yVar);
    % Explicit axis limits, recomputed fresh every redraw: cla('reset') at
    % the top of this function does not reliably clear a previous manual
    % zoom/pan on a uiaxes, so without this the map could keep showing a
    % stale, cropped view from an earlier interaction. Padding is 4% of the
    % data span (a minimum floor for degenerate all-equal-value cases), and
    % the current-design marker is folded into the range so it is always
    % visible even if it sits outside the swept (m,Q) grid.
    xr = [min([X(:); curX]), max([X(:); curX])];
    yr = [min([Y(:); curY]), max([Y(:); curY])];
    padX = max(0.04*(xr(2)-xr(1)), 1e-6);
    padY = max(0.04*(yr(2)-yr(1)), 1e-6);
    xlim(paretoAx, [xr(1)-padX, xr(2)+padX]);
    ylim(paretoAx, [yr(1)-padY, yr(2)+padY]);
    title(paretoAx, 'Feasibility Map (green = feasible)', 'FontWeight', 'bold');
    grid(paretoAx, 'on'); legend(paretoAx, 'Location', 'eastoutside', 'FontSize', 8);
    hold(paretoAx, 'off');
end

function V = pickVar(name, mv, qv, gmv, zmv)
    switch name
        case 'm',           V = mv;
        case 'Q',           V = qv;
        case 'Gain Margin', V = gmv;
        otherwise,          V = zmv;
    end
end

