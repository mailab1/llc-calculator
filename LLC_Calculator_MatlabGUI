        '                k, R.fsw/1e3, ''-'', ''-'', ''-'', ''-'', R.msg);'; ...
        '    end'; ...
        'end'; ...
        ''; ...
        'function val = getSig(simOut, name)'; ...
        '% Signal fetch: logged output -> direct field -> base workspace.'; ...
        '    val = [];'; ...
